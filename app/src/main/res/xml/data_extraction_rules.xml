<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+). Nothing leaves the device: the WebView's AO3 session cookies, the library database and the
    downloaded EPUBs all stay in app-private storage. allowBackup="false" alone isn't enough here: on some
    manufacturers' devices it stops cloud backup but still allows device-to-device transfer (verified against
    developer.android.com/identity/data/autobackup on 2026-09-27). path="." excludes a whole domain.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
